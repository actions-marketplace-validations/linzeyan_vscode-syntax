{
  "name": "poly-editor",
  "displayName": "Poly Editor",
  "description": "Editor-side conveniences with no CI counterpart: copy path:line references in the same shape poly's diagnostics print.",
  "version": "0.13.3",
  "publisher": "ricky",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/preview.js"
    ],
    "configuration": {
      "title": "Poly Editor",
      "properties": {
        "poly.indentTint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Tint each level of leading whitespace, and mark whitespace that does not fill a level. Colours are the poly.indentLevel* / poly.indentPartial theme colours, overridable in workbench.colorCustomizations."
        },
        "poly.imagePreview.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a thumbnail in the gutter for lines that name an image file which exists."
        },
        "poly.referencesCodeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a reference count above each declaration, an implementation count above each type and method -- `N impls` over an interface (who satisfies it) and `N interfaces` over a concrete type (what it satisfies) -- and `N methods` over a type whose methods are declared outside it, as Go's are. Every count comes from whatever providers the language already has; poly analyses nothing. Clicking a count of one goes straight there; clicking a larger one opens the References panel."
        },
        "poly.protobufCodeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Link a .proto declaration to the Go protoc generated for it: `go type` over a message or enum, `go server` and `go client` over a service. The lens appears only when the generated file is in the workspace and the declaration is in it. Covers protoc-gen-go and protoc-gen-go-grpc; connect-go and other generators are not predictable from the proto and are left alone."
        },
        "poly.runCodeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show `run | debug` above a program's entry point -- `main` in Go, Rust, C, C++ and Java, `Main` in C#. poly ships no debugger: both start whatever the editor's own F5 would, out of the debug extension already installed for the language."
        },
        "poly.markdownMermaid.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render ```mermaid fences as diagrams in the markdown preview. Ignored on VSCode 1.135 and later, which ships the same renderer as a built-in (mermaid-markdown-features): poly stands down rather than draw a second diagram over the first."
        },
        "poly.postfixCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Offer postfix templates after a dot: `err.if` expands to `if err != nil { }` in Go, `if (err) { }` in TypeScript, `if err:` in Python. Covers go, rust, swift, typescript, javascript (and their react variants), python, lua, c and cpp. These are text templates, not analysis -- poly reads the characters left of the dot and rearranges them, and sorts them after whatever the language server offered."
        },
        "poly.todo.tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "TODO",
            "FIXME",
            "HACK",
            "XXX",
            "BUG"
          ],
          "description": "Markers the TODOs view lists. Matched as whole words, case-sensitively; entries that are not plain words are ignored."
        }
      }
    },
    "colors": [
      {
        "id": "poly.indentLevel1",
        "description": "Background of the first indent level.",
        "defaults": {
          "dark": "#FFFF4012",
          "light": "#FFFF4012",
          "highContrast": "#FFFF4020"
        }
      },
      {
        "id": "poly.indentLevel2",
        "description": "Background of the second indent level.",
        "defaults": {
          "dark": "#7FFF7F12",
          "light": "#7FFF7F12",
          "highContrast": "#7FFF7F20"
        }
      },
      {
        "id": "poly.indentLevel3",
        "description": "Background of the third indent level.",
        "defaults": {
          "dark": "#FF7FFF12",
          "light": "#FF7FFF12",
          "highContrast": "#FF7FFF20"
        }
      },
      {
        "id": "poly.indentLevel4",
        "description": "Background of the fourth indent level; levels beyond it cycle.",
        "defaults": {
          "dark": "#4FECEC12",
          "light": "#4FECEC12",
          "highContrast": "#4FECEC20"
        }
      },
      {
        "id": "poly.indentPartial",
        "description": "Background of leading whitespace that does not fill an indent level.",
        "defaults": {
          "dark": "#80202099",
          "light": "#80202066",
          "highContrast": "#802020CC"
        }
      }
    ],
    "commands": [
      {
        "command": "poly.copyPathWithLine",
        "title": "Copy Path with Line Numbers",
        "category": "Poly"
      },
      {
        "command": "poly.insertTableOfContents",
        "title": "Insert Table of Contents",
        "category": "Poly"
      },
      {
        "command": "poly.toggleBold",
        "title": "Toggle Bold",
        "category": "Poly"
      },
      {
        "command": "poly.toggleItalic",
        "title": "Toggle Italic",
        "category": "Poly"
      },
      {
        "command": "poly.refreshTodos",
        "title": "Refresh TODOs",
        "category": "Poly",
        "icon": "$(refresh)"
      },
      {
        "command": "poly.extractVariable",
        "title": "Extract Variable",
        "category": "Poly"
      },
      {
        "command": "poly.inlineVariable",
        "title": "Inline Variable",
        "category": "Poly"
      },
      {
        "command": "poly.moveToNewFile",
        "title": "Move to New File",
        "category": "Poly"
      },
      {
        "command": "poly.changeSignature",
        "title": "Change Signature",
        "category": "Poly"
      },
      {
        "command": "poly.implementInterface",
        "title": "Implement Interface",
        "category": "Poly"
      },
      {
        "command": "poly.nextChangedFile",
        "title": "Go to Next Changed File",
        "category": "Poly"
      },
      {
        "command": "poly.previousChangedFile",
        "title": "Go to Previous Changed File",
        "category": "Poly"
      },
      {
        "command": "poly.revertAndSave",
        "title": "Revert Selected Changes and Save",
        "category": "Poly"
      },
      {
        "command": "poly.continueList",
        "title": "Continue List",
        "category": "Poly"
      },
      {
        "command": "poly.indentListItem",
        "title": "Indent List Item",
        "category": "Poly"
      },
      {
        "command": "poly.outdentListItem",
        "title": "Outdent List Item",
        "category": "Poly"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "polyTodos",
          "name": "TODOs"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "poly.copyPathWithLine",
          "group": "9_cutcopypaste"
        }
      ],
      "view/title": [
        {
          "command": "poly.refreshTodos",
          "when": "view == polyTodos",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "poly.continueList",
          "when": "false"
        },
        {
          "command": "poly.indentListItem",
          "when": "false"
        },
        {
          "command": "poly.outdentListItem",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "poly.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "poly.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "poly.continueList",
        "key": "enter",
        "when": "editorTextFocus && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible && editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill|yaml)$/"
      },
      {
        "command": "poly.indentListItem",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly && !editorTabMovesFocus && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible && editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "poly.outdentListItem",
        "key": "shift+tab",
        "when": "editorTextFocus && !editorReadonly && !editorTabMovesFocus && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible && editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "poly.nextChangedFile",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "config.git.enabled && !git.missing"
      },
      {
        "command": "poly.previousChangedFile",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "config.git.enabled && !git.missing"
      },
      {
        "command": "poly.revertAndSave",
        "key": "alt+q",
        "when": "editorTextFocus && !editorReadonly && config.git.enabled && !git.missing && resourceScheme == file"
      },
      {
        "command": "poly.extractVariable",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "poly.inlineVariable",
        "key": "ctrl+alt+shift+v",
        "mac": "cmd+alt+shift+v",
        "when": "editorTextFocus && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify && esbuild src/preview/mermaid.ts --bundle --outfile=dist/preview.js --format=iife --platform=browser --minify",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.preview.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@11.5.3",
  "dependencies": {
    "@mermaid-js/layout-tidy-tree": "^1.0.0",
    "mermaid": "^11.17.2"
  }
}
