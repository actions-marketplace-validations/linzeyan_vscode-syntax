{
  "name": "poly-editor",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.16.0",
  "publisher": "ricky",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/preview.js"
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "poly.indentTint.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.indentTint.enabled.description%"
        },
        "poly.imagePreview.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.imagePreview.enabled.description%"
        },
        "poly.referencesCodeLens.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.referencesCodeLens.enabled.description%"
        },
        "poly.protobufCodeLens.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.protobufCodeLens.enabled.description%"
        },
        "poly.runCodeLens.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.runCodeLens.enabled.description%"
        },
        "poly.markdownMermaid.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.markdownMermaid.enabled.description%"
        },
        "poly.postfixCompletion.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.postfixCompletion.enabled.description%"
        },
        "poly.todo.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.todo.enabled.description%"
        },
        "poly.todo.tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "TODO",
            "FIXME",
            "HACK",
            "XXX",
            "BUG"
          ],
          "description": "%config.todo.tags.description%"
        }
      }
    },
    "colors": [
      {
        "id": "poly.indentLevel1",
        "description": "%color.indentLevel1.description%",
        "defaults": {
          "dark": "#FFFF4012",
          "light": "#FFFF4012",
          "highContrast": "#FFFF4020"
        }
      },
      {
        "id": "poly.indentLevel2",
        "description": "%color.indentLevel2.description%",
        "defaults": {
          "dark": "#7FFF7F12",
          "light": "#7FFF7F12",
          "highContrast": "#7FFF7F20"
        }
      },
      {
        "id": "poly.indentLevel3",
        "description": "%color.indentLevel3.description%",
        "defaults": {
          "dark": "#FF7FFF12",
          "light": "#FF7FFF12",
          "highContrast": "#FF7FFF20"
        }
      },
      {
        "id": "poly.indentLevel4",
        "description": "%color.indentLevel4.description%",
        "defaults": {
          "dark": "#4FECEC12",
          "light": "#4FECEC12",
          "highContrast": "#4FECEC20"
        }
      },
      {
        "id": "poly.indentPartial",
        "description": "%color.indentPartial.description%",
        "defaults": {
          "dark": "#80202099",
          "light": "#80202066",
          "highContrast": "#802020CC"
        }
      }
    ],
    "commands": [
      {
        "command": "poly.copyPathWithLine",
        "title": "%command.copyPathWithLine.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.insertTableOfContents",
        "title": "%command.insertTableOfContents.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.toggleBold",
        "title": "%command.toggleBold.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.toggleItalic",
        "title": "%command.toggleItalic.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.refreshTodos",
        "title": "%command.refreshTodos.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "poly.runFile",
        "title": "%command.runFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.extractVariable",
        "title": "%command.extractVariable.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.inlineVariable",
        "title": "%command.inlineVariable.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.moveToNewFile",
        "title": "%command.moveToNewFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.changeSignature",
        "title": "%command.changeSignature.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.implementInterface",
        "title": "%command.implementInterface.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.nextChangedFile",
        "title": "%command.nextChangedFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.previousChangedFile",
        "title": "%command.previousChangedFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.revertAndSave",
        "title": "%command.revertAndSave.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.continueList",
        "title": "%command.continueList.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.indentListItem",
        "title": "%command.indentListItem.title%",
        "category": "%command.category%"
      },
      {
        "command": "poly.outdentListItem",
        "title": "%command.outdentListItem.title%",
        "category": "%command.category%"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "polyTodos",
          "name": "%view.polyTodos.name%",
          "when": "config.poly.todo.enabled"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "poly.copyPathWithLine",
          "group": "9_cutcopypaste"
        }
      ],
      "view/title": [
        {
          "command": "poly.refreshTodos",
          "when": "view == polyTodos",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "poly.refreshTodos",
          "when": "config.poly.todo.enabled"
        },
        {
          "command": "poly.continueList",
          "when": "false"
        },
        {
          "command": "poly.indentListItem",
          "when": "false"
        },
        {
          "command": "poly.outdentListItem",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "poly.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "poly.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "poly.continueList",
        "key": "enter",
        "when": "editorTextFocus && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible && editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill|yaml)$/"
      },
      {
        "command": "poly.indentListItem",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly && !editorTabMovesFocus && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible && editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "poly.outdentListItem",
        "key": "shift+tab",
        "when": "editorTextFocus && !editorReadonly && !editorTabMovesFocus && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible && editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "poly.nextChangedFile",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "config.git.enabled && !git.missing"
      },
      {
        "command": "poly.previousChangedFile",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "config.git.enabled && !git.missing"
      },
      {
        "command": "poly.revertAndSave",
        "key": "alt+q",
        "when": "editorTextFocus && !editorReadonly && config.git.enabled && !git.missing && resourceScheme == file"
      },
      {
        "command": "poly.extractVariable",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "poly.inlineVariable",
        "key": "ctrl+alt+shift+v",
        "mac": "cmd+alt+shift+v",
        "when": "editorTextFocus && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify && esbuild src/preview/mermaid.ts --bundle --outfile=dist/preview.js --format=iife --platform=browser --minify",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.preview.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@11.5.3",
  "dependencies": {
    "@mermaid-js/layout-tidy-tree": "^1.0.0",
    "mermaid": "^11.17.2"
  }
}
