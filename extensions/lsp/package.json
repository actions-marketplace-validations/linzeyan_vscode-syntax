{
  "name": "poly-lsp",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.17.0",
  "publisher": "ricky",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:markdown",
    "onLanguage:prompt",
    "onLanguage:instructions",
    "onLanguage:chatagent",
    "onLanguage:skill",
    "onLanguage:toml",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:yaml",
    "onLanguage:python",
    "onLanguage:sql",
    "onLanguage:xml",
    "onLanguage:html",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro",
    "onLanguage:graphql",
    "onLanguage:php",
    "onLanguage:dockerfile",
    "onLanguage:shellscript",
    "onLanguage:rust",
    "onLanguage:go",
    "onLanguage:lua",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:terraform",
    "onLanguage:swift",
    "onLanguage:protobuf",
    "onLanguage:r",
    "onLanguage:handlebars",
    "onLanguage:dockercompose",
    "onLanguage:github-actions-workflow",
    "workspaceContains:.editorconfig"
  ],
  "contributes": {
    "languages": [
      {
        "id": "shellscript",
        "extensions": [
          ".bats",
          ".azcli"
        ]
      },
      {
        "id": "markdown",
        "extensions": [
          ".mdx"
        ]
      }
    ],
    "commands": [
      {
        "command": "poly.formatFile",
        "title": "%command.formatFile.title%"
      },
      {
        "command": "poly.formatPath",
        "title": "%command.formatPath.title%"
      },
      {
        "command": "poly.formatWorkspace",
        "title": "%command.formatWorkspace.title%"
      },
      {
        "command": "poly.formatGitRepo",
        "title": "%command.formatGitRepo.title%"
      },
      {
        "command": "poly.formatGitChanged",
        "title": "%command.formatGitChanged.title%"
      },
      {
        "command": "poly.lintPath",
        "title": "%command.lintPath.title%"
      },
      {
        "command": "poly.analyzeDeadCode",
        "title": "%command.analyzeDeadCode.title%"
      },
      {
        "command": "poly.minify",
        "title": "%command.minify.title%"
      },
      {
        "command": "poly.toggleFormat",
        "title": "%command.toggleFormat.title%"
      },
      {
        "command": "poly.checkForUpdates",
        "title": "%command.checkForUpdates.title%"
      },
      {
        "command": "poly.showOutput",
        "title": "%command.showOutput.title%"
      },
      {
        "command": "poly.createGoWork",
        "title": "%command.createGoWork.title%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "poly.formatPath",
          "group": "7_modification@10"
        },
        {
          "command": "poly.lintPath",
          "group": "7_modification@11"
        }
      ]
    },
    "keybindings": [
      {
        "command": "poly.minify",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(json|jsonc|css|html|xml|javascript|javascriptreact|typescript|typescriptreact)$/"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "poly.serverPath": {
          "type": "string",
          "default": "",
          "description": "%config.serverPath.description%"
        },
        "poly.lintOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.lintOnSave.description%"
        },
        "poly.format.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.format.enabled.description%"
        },
        "poly.deadCodeCodeLens.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.deadCodeCodeLens.enabled.description%"
        },
        "poly.languageServers": {
          "type": "boolean",
          "default": false,
          "description": "%config.languageServers.description%"
        },
        "poly.languageServerLogs": {
          "type": "boolean",
          "default": true,
          "description": "%config.languageServerLogs.description%"
        },
        "poly.memoryLog": {
          "type": "boolean",
          "default": false,
          "description": "%config.memoryLog.description%"
        },
        "poly.updateCheck.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.updateCheck.enabled.description%"
        },
        "poly.updateCheck.intervalDays": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "description": "%config.updateCheck.intervalDays.description%"
        }
      }
    },
    "configurationDefaults": {
      "[typescript]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[typescriptreact]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[javascript]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[javascriptreact]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[json]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[jsonc]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[markdown]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[prompt]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[instructions]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[chatagent]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[skill]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[toml]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[css]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[scss]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[less]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[yaml]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[python]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[sql]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[xml]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[html]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[vue]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[svelte]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[astro]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[graphql]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[php]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[dockerfile]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[shellscript]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[lua]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[rust]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[go]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[c]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[cpp]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[swift]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[terraform]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[protobuf]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[r]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[handlebars]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[dockercompose]": { "editor.defaultFormatter": "ricky.poly-lsp" },
      "[github-actions-workflow]": { "editor.defaultFormatter": "ricky.poly-lsp" }
    }
  },
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "typecheck": "tsc --noEmit",
    "test:build": "pnpm run build && tsc -p tsconfig.test.json",
    "test": "pnpm run test:build && node out/test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.1",
    "mocha": "^10.7.0",
    "typescript": "^5.4.0"
  }
}
